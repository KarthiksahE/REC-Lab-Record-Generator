# Server Configurations
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Firebase Authentication (for JWT verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional: Path to Firebase Service Account JSON if using administrative tasks
# FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-credentials.json

# Supabase Configurations
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase PostgreSQL connection string (direct connection for SQLAlchemy/psycopg2)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-supabase-ref.supabase.co:5432/postgres

# Document Engine Settings
TEMPLATE_PATH=templates/Lab_Record_Template.docx
LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# CORS Settings (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
